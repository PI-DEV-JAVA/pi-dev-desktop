<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentospidev.controllers.AdminDashboardController"
      stylesheets="@/style/app.css" style="-fx-background-color: #f0f2f5;">

    <!-- ======= LEFT SIDEBAR ======= -->
    <VBox fx:id="sidebar" styleClass="sidebar">
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 1 1 1 1;">
            <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                <image><Image url="@/images/logo.png"/></image>
            </ImageView>
            <Label text="Talentos" styleClass="sidebar-logo"/>
        </HBox>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="MAIN" styleClass="sidebar-section-label"/>
        <Button text="📊  Dashboard" styleClass="sidebar-button-active" onAction="#handleDashboard"/>
        <Button text="💼  Job Offers" styleClass="sidebar-button" onAction="#handleJobOffers"/>
        <Button text="📋  Activities" styleClass="sidebar-button" onAction="#handleActivities"/>
        <Button text="📂  Projects" styleClass="sidebar-button" onAction="#handleProjects"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="ACCOUNT" styleClass="sidebar-section-label"/>
        <Button text="🚪  Logout" styleClass="sidebar-button-danger" onAction="#handleLogout"/>
    </VBox>

    <!-- ======= MAIN CONTENT ======= -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="24" style="-fx-padding: 30;">

            <!-- Page Header -->
            <VBox spacing="4">
                <Label text="Admin Dashboard" style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                <Label text="Manage all users and platform statistics"
                       style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
            </VBox>

            <!-- Stats Row -->
            <HBox spacing="16">
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #eef2ff; -fx-background-radius: 14; -fx-padding: 20;
                             -fx-border-color: #6366f122; -fx-border-radius: 14;">
                    <Label text="Total Users" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                    <Label fx:id="totalUsersLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #6366f1;"/>
                </VBox>
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #f0fdf4; -fx-background-radius: 14; -fx-padding: 20;
                             -fx-border-color: #22c55e22; -fx-border-radius: 14;">
                    <Label text="Active" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                    <Label fx:id="activeUsersLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #22c55e;"/>
                </VBox>
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #fef3c7; -fx-background-radius: 14; -fx-padding: 20;
                             -fx-border-color: #f59e0b22; -fx-border-radius: 14;">
                    <Label text="Candidates" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                    <Label fx:id="candidatesLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #f59e0b;"/>
                </VBox>
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #fce4ec; -fx-background-radius: 14; -fx-padding: 20;
                             -fx-border-color: #e91e6322; -fx-border-radius: 14;">
                    <Label text="Recruiters" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                    <Label fx:id="recruitersLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #e91e63;"/>
                </VBox>
            </HBox>

            <!-- Filters -->
            <HBox spacing="12" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 12 16;
                         -fx-border-color: #e5e7eb; -fx-border-radius: 12;">
                <TextField fx:id="searchField" promptText="🔍 Search users..."
                           style="-fx-background-color: #f3f4f6; -fx-border-color: transparent;
                                  -fx-background-radius: 8; -fx-padding: 8 12; -fx-pref-width: 220; -fx-font-size: 12px;"/>
                <ComboBox fx:id="roleFilterBox" prefWidth="120" style="-fx-font-size: 11px;"/>
                <ComboBox fx:id="sortByBox" prefWidth="120" style="-fx-font-size: 11px;"/>
                <ComboBox fx:id="sortOrderBox" prefWidth="100" style="-fx-font-size: 11px;"/>
            </HBox>

            <!-- Users List -->
            <ListView fx:id="userListView" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
        </VBox>
    </ScrollPane>
</HBox>
