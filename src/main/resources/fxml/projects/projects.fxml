<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentospidev.controllers.Activities.ProjectController"
      stylesheets="@/style/app.css" style="-fx-background-color: #f0f2f5;">

    <!-- ======= SIDEBAR (Recruiter) ======= -->
    <VBox fx:id="sidebar" styleClass="sidebar">
       <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 1 1 1 1;">
            <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                <image><Image url="@/images/logo.png"/></image>
            </ImageView>
            <Label text="Talentos" styleClass="sidebar-logo"/>
        </HBox>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="MAIN" styleClass="sidebar-section-label"/>
        <Button text="📊  Dashboard" styleClass="sidebar-button" onAction="#handleDashboard"/>
        <Button text="💼  Job Offers" styleClass="sidebar-button" onAction="#handleJobOffers"/>
        <Button text="📈  Trends" styleClass="sidebar-button" onAction="#handleTrends"/>
        <Button text="ðŸŽ¤  Interviews" styleClass="sidebar-button" onAction="#handleInterviews"/>
        <Button text="📚  Courses" styleClass="sidebar-button" onAction="#handleCourses" maxWidth="Infinity"/>
        <Button text="ðŸ“…  Events" styleClass="sidebar-button" onAction="#handleEvents"/>
        <Button text="⚡  My Circle" styleClass="sidebar-button" onAction="#handleMyCircle"/>
        <Button text="🔔  Notifications" styleClass="sidebar-button" onAction="#handleNotifications"/>
        <Button fx:id="toDoTab" text="✅  To Do" styleClass="sidebar-button" onAction="#handleToDo" visible="false" managed="false"/>
        <Button fx:id="activitiesTab" text="📋  Activities" styleClass="sidebar-button" onAction="#handleActivities"/>
        <Button fx:id="projectsTab" text="📂  Projects" styleClass="sidebar-button-active" onAction="#handleProjects"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="ACCOUNT" styleClass="sidebar-section-label"/>
        <Button text="👤  My Profile" styleClass="sidebar-button" onAction="#handleMyProfile"/>
        <Button text="⚙  Settings" styleClass="sidebar-button" onAction="#handleSettings"/>
        <Button text="🚪  Logout" styleClass="sidebar-button-danger" onAction="#handleLogout"/>
    </VBox>

    <!-- ======= MAIN CONTENT ======= -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="24" style="-fx-padding: 30;">

            <!-- Page Header -->
            <HBox alignment="BOTTOM_LEFT">
                <VBox spacing="4">
                    <Label text="Projects" style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                    <Label text="Create and manage your projects"
                           style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="🔍 Search projects..."
                           prefWidth="250"
                           style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 10;
                                  -fx-background-radius: 10; -fx-padding: 10 14; -fx-font-size: 12px;"/>
            </HBox>

            <HBox spacing="24" VBox.vgrow="ALWAYS">
                <!-- LEFT: Form Card -->
                <VBox prefWidth="360" spacing="16"
                      style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16;
                             -fx-border-color: #e5e7eb; -fx-border-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);">

                    <Label text="New Project" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>

                    <VBox spacing="5">
                        <Label text="NAME" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                        <TextField fx:id="nameField" promptText="Project name"
                                   style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb;
                                          -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="DESCRIPTION" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                        <TextArea fx:id="descriptionField" prefRowCount="3" promptText="Project description"
                                  wrapText="true"
                                  style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="STATUS" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                        <ComboBox fx:id="statusCombo" maxWidth="Infinity" promptText="Select status"
                                  style="-fx-background-radius: 8; -fx-font-size: 12px;"/>
                    </VBox>

                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="START DATE" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                            <DatePicker fx:id="startDatePicker" maxWidth="Infinity" style="-fx-font-size: 11px;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="END DATE" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                            <DatePicker fx:id="endDatePicker" maxWidth="Infinity" style="-fx-font-size: 11px;"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="BUDGET ($)" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                        <TextField fx:id="budgetField" promptText="0"
                                   style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb;
                                          -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;"/>
                    </VBox>

                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button text="Clear" onAction="#clearFields"
                                style="-fx-background-color: transparent; -fx-text-fill: #9ca3af; -fx-font-weight: 600;"/>
                        <Button fx:id="submitBtn" text="Create Project" onAction="#addProject"
                                style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6);
                                       -fx-text-fill: white; -fx-font-weight: 700; -fx-padding: 10 24;
                                       -fx-background-radius: 10; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- RIGHT: Projects List -->
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="YOUR PROJECTS" style="-fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-weight: 700;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="⟳ Refresh" onAction="#loadProjects"
                                style="-fx-background-color: #f3f4f6; -fx-background-radius: 16;
                                       -fx-text-fill: #6b7280; -fx-padding: 4 12; -fx-font-size: 11px;"/>
                    </HBox>
                    <ScrollPane fitToWidth="true"
                                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                        <VBox fx:id="listContainer" spacing="12"/>
                    </ScrollPane>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</HBox>
