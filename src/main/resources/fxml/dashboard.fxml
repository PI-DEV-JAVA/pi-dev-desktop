<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentospidev.controllers.DashboardController"
      stylesheets="@/style/app.css" style="-fx-background-color: #f0f2f5;">

    <!-- ======= LEFT SIDEBAR ======= -->
    <VBox fx:id="sidebar" styleClass="sidebar">
       <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 1 1 1 1;">
            <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <Label text="Talentos" styleClass="sidebar-logo"/>
        </HBox>

        <Separator style="-fx-opacity: 0.1;"/>

        <Label text="MAIN" styleClass="sidebar-section-label"/>
        <Button text="📊  Dashboard" styleClass="sidebar-button-active" onAction="#handleDashboard"/>
        <Button text="💼  Job Offers" styleClass="sidebar-button" onAction="#handleJobOffers"/>
        <Button text="🔔  Notifications" styleClass="sidebar-button" onAction="#handleNotifications"/>
        <Button text="✅  To Do" styleClass="sidebar-button" onAction="#handleToDo"/>

        <Region VBox.vgrow="ALWAYS"/>

        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="ACCOUNT" styleClass="sidebar-section-label"/>
        <Button text="👤  My Profile" styleClass="sidebar-button" onAction="#handleMyProfile"/>
        <Button text="⚙  Settings" styleClass="sidebar-button" onAction="#handleSettings"/>
        <Button text="🚪  Logout" styleClass="sidebar-button-danger" onAction="#handleLogout"/>
    </VBox>

    <!-- ======= MAIN CONTENT (stacked layout) ======= -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="20" style="-fx-padding: 28;">

            <!-- Welcome Header + Quick Stats -->
            <VBox fx:id="welcomeSection" spacing="6"/>

            <!-- My Applications (full width, compact) -->
            <VBox fx:id="applicationsSection" spacing="12"/>

            <!-- ====== Profiles Discovery (full width) ====== -->
            <VBox spacing="0">
                <!-- Section Header -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 0 0 12 0;">
                    <Label text="🌐 Discover People" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="countLabel" text="0 profiles"
                           style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-font-weight: 600;"/>
                </HBox>

                <!-- Filter / Search Bar -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-background-color: white; -fx-background-radius: 12 12 0 0;
                             -fx-padding: 12 20; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
                    <HBox alignment="CENTER_LEFT" spacing="6"
                          style="-fx-background-color: #f3f4f6; -fx-background-radius: 8; -fx-padding: 4 12;"
                          HBox.hgrow="ALWAYS" maxWidth="280">
                        <Label text="🔍" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;"/>
                        <TextField fx:id="searchField" promptText="Search by name, title, location..."
                                   style="-fx-background-color: transparent; -fx-border-color: transparent;
                                          -fx-padding: 5; -fx-font-size: 12px;"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <ComboBox fx:id="roleFilterBox" style="-fx-font-size: 11px;" prefWidth="130"
                              promptText="Role"/>
                    <ComboBox fx:id="sortByBox" style="-fx-font-size: 11px;" prefWidth="120"
                              promptText="Sort by"/>
                    <ComboBox fx:id="sortOrderBox" style="-fx-font-size: 11px;" prefWidth="100"
                              promptText="Order"/>
                </HBox>

                <!-- Profiles List -->
                <ListView fx:id="feedListView" VBox.vgrow="ALWAYS" prefHeight="450"
                          style="-fx-background-radius: 0 0 12 12;"/>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>
