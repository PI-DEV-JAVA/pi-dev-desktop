<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="talentos.pidev.controllers.interviews.MediaController">

    <center>
        <ImageView fx:id="cameraView"
                   fitWidth="640"
                   fitHeight="480"
                   preserveRatio="true"
                   smooth="true" />
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER">

            <Button text="Start Camera" onAction="#startCamera"/>
            <Button text="Stop Camera" onAction="#stopCamera"/>

            <Button text="Start Mic" onAction="#startMic"/>
            <Button text="Stop Mic" onAction="#stopMic"/>

            <Button text="Stop All" onAction="#stopAll"/>
        </HBox>
    </bottom>

</BorderPane>