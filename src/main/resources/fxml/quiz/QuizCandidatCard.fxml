<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="talentos.pidev.controllers.quiz.QuizCandidatCardController"
      spacing="10"
      prefWidth="320"
      styleClass="quiz-card">

    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <Label fx:id="lbTitre" text="Titre" style="-fx-font-size:16px; -fx-font-weight:800;"/>

    <Label fx:id="lbDesc" text="Description..."
           wrapText="true"
           style="-fx-opacity:0.85;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="lbDuree" text="Durée: -- min" style="-fx-opacity:0.8;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Passer" onAction="#onPasser" styleClass="btn-info"/>
    </HBox>

</VBox>