<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="talentos.pidev.controllers.quiz.ChoiceCardController"
      spacing="12"
      alignment="CENTER_LEFT"
      prefWidth="520"
      styleClass="list-row-card">

    <padding>
        <Insets top="12" right="14" bottom="12" left="14"/>
    </padding>

    <CheckBox fx:id="correctCheck" text="Correct"/>

    <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label fx:id="texteLabel" wrapText="true" styleClass="row-title"/>
        <Label text="Cochez si c'est la bonne réponse" styleClass="muted-label"/>
    </VBox>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="Modifier" onAction="#onEdit" styleClass="btn-secondary"/>
        <Button text="Supprimer" onAction="#onDelete" styleClass="btn-danger"/>
    </HBox>

</HBox>