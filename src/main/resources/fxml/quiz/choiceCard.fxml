<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="talentos.pidev.controllers.quiz.ChoiceCardController"
      spacing="10"
      prefWidth="320"
      styleClass="card">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <CheckBox fx:id="correctCheck" text="Correct" />
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Modifier" onAction="#onEdit" styleClass="secondary-button"/>
        <Button text="Supprimer" onAction="#onDelete" styleClass="danger-button"/>
    </HBox>

    <Label fx:id="texteLabel" wrapText="true" styleClass="row-title"/>
</VBox>