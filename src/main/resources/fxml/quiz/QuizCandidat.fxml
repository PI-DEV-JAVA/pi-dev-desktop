<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="talentos.pidev.controllers.quiz.QuizCandidatController"
      spacing="12" styleClass="content-card">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Quiz disponibles" style="-fx-font-size:18px; -fx-font-weight:800;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Rafraîchir" onAction="#onRefresh" styleClass="secondary-button"/>
    </HBox>

    <!-- Search -->
    <TextField fx:id="searchField"
               promptText="Rechercher un quiz (titre, description...)"
               onKeyReleased="#onSearch"/>

    <!-- Grid cards -->
    <ScrollPane fitToWidth="true" styleClass="transparent-scroll">
        <content>
            <FlowPane fx:id="cardsContainer" hgap="14" vgap="14" prefWrapLength="900"/>
        </content>
    </ScrollPane>

</VBox>