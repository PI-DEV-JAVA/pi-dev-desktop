<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="talentos.pidev.controllers.quiz.ChoicesRHController"
      spacing="12"
      styleClass="content-card">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button text="← Retour" onAction="#onBack" styleClass="secondary-button"/>
        <Label fx:id="titleLabel" text="Choix" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Ajouter" onAction="#onAdd" styleClass="primary-button"/>
        <Button text="Rafraîchir" onAction="#onRefresh" styleClass="secondary-button"/>
    </HBox>

    <FlowPane fx:id="cardsContainer" hgap="12" vgap="12" />
</VBox>