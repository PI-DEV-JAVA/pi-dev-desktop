<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="talentos.pidev.controllers.quiz.QuestionRowController"
      spacing="12"
      alignment="CENTER_LEFT"
      styleClass="list-row-card">

    <padding>
        <Insets top="12" right="14" bottom="12" left="14"/>
    </padding>

    <!-- publish -->
    <CheckBox fx:id="publishedCheck" text="Afficher"/>

    <!-- text -->
    <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label fx:id="enonceLabel" wrapText="true" styleClass="row-title"/>
        <HBox spacing="12">
            <Label fx:id="nbChoixLabel" styleClass="muted-label"/>
            <Label fx:id="correctLabel" styleClass="muted-label"/>
        </HBox>
    </VBox>

    <!-- actions -->
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="Choix" onAction="#onChoices" styleClass="btn-secondary"/>
        <Button text="Modifier" onAction="#onEdit" styleClass="btn-secondary"/>
        <Button text="Supprimer" onAction="#onDelete" styleClass="btn-secondary"/>
    </HBox>

</HBox>