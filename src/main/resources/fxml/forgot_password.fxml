<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="talentospidev.controllers.ForgotPasswordController"
            stylesheets="@/style/app.css"
            style="-fx-background-color: linear-gradient(to bottom right, #eef2ff, #f0f2f5, #ede9fe);">

    <center>
        <VBox spacing="16" alignment="CENTER" styleClass="login-card"
              maxWidth="440" maxHeight="560">

            <padding>
                <Insets top="32" right="48" bottom="32" left="48"/>
            </padding>

            <!-- Logo -->
            <ImageView fitHeight="50" preserveRatio="true" pickOnBounds="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>

            <Label fx:id="headerTitle" text="RESET PASSWORD" styleClass="title-text"/>
            <Label fx:id="headerSubtitle" text="Enter your email to receive a verification code"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 12px; -fx-wrap-text: true; -fx-text-alignment: center;"
                   maxWidth="320"/>

            <!-- Status message (success/error) -->
            <Label fx:id="statusLabel" styleClass="error-banner" text="" visible="false" managed="false" maxWidth="320"/>

            <!-- ====== STEP 1: Email Entry ====== -->
            <VBox fx:id="stepEmail" spacing="12" maxWidth="320" alignment="CENTER">
                <VBox spacing="2">
                    <HBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="E-mail" styleClass="field-label"/>
                        <Label text="*" styleClass="required-star"/>
                    </HBox>
                    <TextField fx:id="emailField" promptText="Enter your registered email" styleClass="input-field"/>
                    <Label fx:id="emailError" styleClass="error-label" text="" visible="false" managed="false"/>
                </VBox>

                <Button text="SEND CODE" styleClass="primary-button" maxWidth="Infinity" onAction="#handleSendCode"/>
            </VBox>

            <!-- ====== STEP 2: OTP Verification ====== -->
            <VBox fx:id="stepOtp" spacing="12" maxWidth="320" alignment="CENTER"
                  visible="false" managed="false">
                <VBox spacing="2">
                    <Label text="VERIFICATION CODE" styleClass="field-label"/>
                    <TextField fx:id="otpField" promptText="Enter 6-digit code"
                               styleClass="input-field"
                               style="-fx-font-size: 20px; -fx-letter-spacing: 6px; -fx-alignment: center; -fx-font-weight: 800;"
                               maxWidth="220" alignment="CENTER"/>
                    <Label fx:id="otpError" styleClass="error-label" text="" visible="false" managed="false"/>
                </VBox>

                <HBox alignment="CENTER" spacing="6">
                    <Label fx:id="timerLabel" text="Code expires in 10:00"
                           style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
                </HBox>

                <Button text="VERIFY CODE" styleClass="primary-button" maxWidth="Infinity" onAction="#handleVerifyCode"/>

                <Hyperlink fx:id="resendLink" text="Resend code" styleClass="reset-link" onAction="#handleResendCode"/>
            </VBox>

            <!-- ====== STEP 3: New Password ====== -->
            <VBox fx:id="stepNewPassword" spacing="12" maxWidth="320" alignment="CENTER"
                  visible="false" managed="false">
                <VBox spacing="2">
                    <HBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="New Password" styleClass="field-label"/>
                        <Label text="*" styleClass="required-star"/>
                    </HBox>
                    <StackPane>
                        <PasswordField fx:id="newPasswordField" promptText="Min 6 chars, 1 uppercase, 1 digit" styleClass="input-field"/>
                        <TextField fx:id="newPasswordVisible" promptText="Min 6 chars, 1 uppercase, 1 digit"
                                   styleClass="input-field" visible="false" managed="false"/>
                        <Button fx:id="toggleNewPwBtn" text=""
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 8;"
                                onAction="#toggleNewPassword"
                                StackPane.alignment="CENTER_RIGHT"/>
                    </StackPane>
                    <Label fx:id="newPasswordError" styleClass="error-label" text="" visible="false" managed="false"/>
                </VBox>

                <VBox spacing="2">
                    <HBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="Confirm Password" styleClass="field-label"/>
                        <Label text="*" styleClass="required-star"/>
                    </HBox>
                    <StackPane>
                        <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" styleClass="input-field"/>
                        <TextField fx:id="confirmPasswordVisible" promptText="Re-enter password"
                                   styleClass="input-field" visible="false" managed="false"/>
                        <Button fx:id="toggleConfirmPwBtn" text=""
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 8;"
                                onAction="#toggleConfirmPassword"
                                StackPane.alignment="CENTER_RIGHT"/>
                    </StackPane>
                    <Label fx:id="confirmPasswordError" styleClass="error-label" text="" visible="false" managed="false"/>
                </VBox>

                <Button text="RESET PASSWORD" styleClass="primary-button" maxWidth="Infinity" onAction="#handleResetPassword"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER" styleClass="footer">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20"/>
            </padding>
            <Label text="Remembered your password?" styleClass="footer-text"/>
            <Hyperlink text="Login" styleClass="footer-link" onAction="#goToLogin"/>
        </HBox>
    </bottom>
</BorderPane>
