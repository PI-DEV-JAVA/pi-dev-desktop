<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentospidev.controllers.events.AttendanceConfirmController"
      stylesheets="@/style/app.css" style="-fx-background-color: #f0f2f5;">

    <VBox fx:id="sidebar" styleClass="sidebar">
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 1 1 1 1;"><ImageView fitHeight="60" fitWidth="60" preserveRatio="true"><image><Image url="@/images/logo.png"/></image></ImageView><Label text="Talentos" styleClass="sidebar-logo"/></HBox>
        <Separator style="-fx-opacity: 0.1;"/><Label text="MAIN" styleClass="sidebar-section-label"/>
        <Button text="📊  Dashboard" styleClass="sidebar-button" onAction="#handleDashboard"/>
        <Button text="💼  Job Offers" styleClass="sidebar-button" onAction="#handleJobOffers"/>
        <Button text="📈  Trends" styleClass="sidebar-button" onAction="#handleTrends"/>
        <Button text="🎤  Interviews" styleClass="sidebar-button" onAction="#handleInterviews"/>
        <Button text="📚  Courses" styleClass="sidebar-button" onAction="#handleCourses"/>
        <Button text="📅  Events" styleClass="sidebar-button-active" onAction="#handleEvents"/>
        <Button text="⚡  My Circle" styleClass="sidebar-button" onAction="#handleMyCircle"/>
        <Button text="🔔  Notifications" styleClass="sidebar-button" onAction="#handleNotifications"/>
        <Button fx:id="toDoTab" text="✅  To Do" styleClass="sidebar-button" onAction="#handleToDo" visible="false" managed="false"/>
        <Button fx:id="activitiesTab" text="🎯  Activities" styleClass="sidebar-button" onAction="#handleActivities" visible="false" managed="false"/>
        <Button fx:id="projectsTab" text="📁  Projects" styleClass="sidebar-button" onAction="#handleProjects" visible="false" managed="false"/>
        <Region VBox.vgrow="ALWAYS"/><Separator style="-fx-opacity: 0.1;"/><Label text="ACCOUNT" styleClass="sidebar-section-label"/>
        <Button text="👤  My Profile" styleClass="sidebar-button" onAction="#handleMyProfile"/>
        <Button text="⚙  Settings" styleClass="sidebar-button" onAction="#handleSettings"/>
        <Button text="🚪  Logout" styleClass="sidebar-button-danger" onAction="#handleLogout"/>
    </VBox>

    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox spacing="20" style="-fx-padding: 28;" maxWidth="600" alignment="CENTER">
            <Button text="← Back" onAction="#onBack" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 8 16; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-cursor: hand; -fx-font-weight: 600;" alignment="CENTER_LEFT"/>

            <!-- Confirm Card -->
            <VBox spacing="16" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 40; -fx-border-color: #e5e7eb; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 4);">
                <Label text="🎟" style="-fx-font-size: 48px;"/>
                <Label fx:id="eventTitleLbl" text="" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #111827;" wrapText="true" alignment="CENTER"/>
                <Label fx:id="eventDateLbl" text="" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                <Label fx:id="statusLbl" text="" style="-fx-font-size: 14px; -fx-font-weight: 700;"/>

                <Button fx:id="confirmBtn" text="✅ Confirm My Attendance" onAction="#onConfirm"
                        style="-fx-background-color: linear-gradient(to right, #22c55e, #16a34a); -fx-text-fill: white;
                               -fx-background-radius: 12; -fx-padding: 14 36; -fx-font-size: 15px;
                               -fx-font-weight: 700; -fx-cursor: hand;"/>

                <Separator style="-fx-opacity: 0.2;"/>

                <Label text="Your QR Code" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                <ImageView fx:id="qrImageView" fitWidth="200" fitHeight="200" preserveRatio="true"/>
                <Button fx:id="generateQrBtn" text="🔄 Generate QR Code" onAction="#onGenerateQR"
                        style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 10;
                               -fx-padding: 10 24; -fx-font-weight: 700; -fx-cursor: hand;"/>
                <Label fx:id="qrHintLbl" text="Scan this QR to view event statistics" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>
