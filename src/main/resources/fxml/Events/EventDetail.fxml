<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentospidev.controllers.events.EventDetailController"
      stylesheets="@/style/app.css" style="-fx-background-color: #f0f2f5;">

    <VBox fx:id="sidebar" styleClass="sidebar">
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 1 1 1 1;"><ImageView fitHeight="60" fitWidth="60" preserveRatio="true"><image><Image url="@/images/logo.png"/></image></ImageView><Label text="Talentos" styleClass="sidebar-logo"/></HBox>
        <Separator style="-fx-opacity: 0.1;"/><Label text="MAIN" styleClass="sidebar-section-label"/>
        <Button text="📊  Dashboard" styleClass="sidebar-button" onAction="#handleDashboard"/>
        <Button text="💼  Job Offers" styleClass="sidebar-button" onAction="#handleJobOffers"/>
        <Button text="📈  Trends" styleClass="sidebar-button" onAction="#handleTrends"/>
        <Button text="🎤  Interviews" styleClass="sidebar-button" onAction="#handleInterviews"/>
        <Button text="📚  Courses" styleClass="sidebar-button" onAction="#handleCourses"/>
        <Button text="📅  Events" styleClass="sidebar-button-active" onAction="#handleEvents"/>
        <Button text="⚡  My Circle" styleClass="sidebar-button" onAction="#handleMyCircle"/>
        <Button text="🔔  Notifications" styleClass="sidebar-button" onAction="#handleNotifications"/>
        <Button fx:id="toDoTab" text="✅  To Do" styleClass="sidebar-button" onAction="#handleToDo" visible="false" managed="false"/>
        <Button fx:id="activitiesTab" text="🎯  Activities" styleClass="sidebar-button" onAction="#handleActivities" visible="false" managed="false"/>
        <Button fx:id="projectsTab" text="📁  Projects" styleClass="sidebar-button" onAction="#handleProjects" visible="false" managed="false"/>
        <Region VBox.vgrow="ALWAYS"/><Separator style="-fx-opacity: 0.1;"/><Label text="ACCOUNT" styleClass="sidebar-section-label"/>
        <Button text="👤  My Profile" styleClass="sidebar-button" onAction="#handleMyProfile"/>
        <Button text="⚙  Settings" styleClass="sidebar-button" onAction="#handleSettings"/>
        <Button text="🚪  Logout" styleClass="sidebar-button-danger" onAction="#handleLogout"/>
    </VBox>

    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox spacing="20" style="-fx-padding: 28;" maxWidth="800">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="← Back" onAction="#onBack" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 8 16; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-cursor: hand; -fx-font-weight: 600;"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="titleLbl" text="" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                    <Label fx:id="metaLbl" text="" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                </VBox>
            </HBox>

            <!-- Event Info Card -->
            <VBox fx:id="infoCard" spacing="12" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 24; -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 2);">
                <Label fx:id="descLbl" text="" wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                <Label fx:id="locationLbl" text="" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                <Label fx:id="dateLbl" text="" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                <Label fx:id="capacityLbl" text="" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
            </VBox>

            <!-- Organizer Card -->
            <VBox fx:id="organizerCard" spacing="8" style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6); -fx-background-radius: 14; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.3), 10, 0, 0, 3);">
                <Label text="👤 Organizer" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.7); -fx-font-weight: 700;"/>
                <Label fx:id="organizerLbl" text="" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: white;"/>
            </VBox>

            <!-- Actions Row -->
            <HBox fx:id="actionsRow" spacing="10" alignment="CENTER_LEFT"/>

            <!-- Share -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Share:" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 700;"/>
                <Button text="Facebook" onAction="#shareOnFacebook" style="-fx-background-color: #1877f2; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 6 14; -fx-font-size: 11px; -fx-font-weight: 700; -fx-cursor: hand;"/>
                <Button text="Twitter" onAction="#shareOnTwitter" style="-fx-background-color: #1da1f2; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 6 14; -fx-font-size: 11px; -fx-font-weight: 700; -fx-cursor: hand;"/>
                <Button text="LinkedIn" onAction="#shareOnLinkedIn" style="-fx-background-color: #0a66c2; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 6 14; -fx-font-size: 11px; -fx-font-weight: 700; -fx-cursor: hand;"/>
            </HBox>

            <!-- Comments Section -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 24; -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                <Label text="💬 Comments" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
                <VBox fx:id="commentsContainer" spacing="8"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="commentField" promptText="Add a comment..." HBox.hgrow="ALWAYS" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 10 14; -fx-border-color: #e5e7eb;"/>
                    <Button text="Send" onAction="#onAddComment" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20; -fx-font-weight: 700; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>
