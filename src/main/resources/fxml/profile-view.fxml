<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.TextField?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentospidev.controllers.ProfileViewController"
      stylesheets="@/style/app.css" style="-fx-background-color: #f0f2f5;">

    <!-- ======= LEFT SIDEBAR ======= -->
    <VBox styleClass="sidebar">
       <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 1 1 1 1;">
            <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <Label text="Talentos" styleClass="sidebar-logo"/>
        </HBox>

        <Separator style="-fx-opacity: 0.1;"/>

        <Label text="MAIN" styleClass="sidebar-section-label"/>
        <Button text="📊  Dashboard" styleClass="sidebar-button" onAction="#handleBackToDashboard"/>
        <Button text="💼  Job Offers" styleClass="sidebar-button" onAction="#handleJobOffers"/>
        <Button text="⚡  My Circle" styleClass="sidebar-button" onAction="#handleMyCircle"/>
        <Button text="🔔  Notifications" styleClass="sidebar-button" onAction="#handleNotifications"/>
        <!-- Candidate only -->
        <Button fx:id="toDoTab" text="✅  To Do" styleClass="sidebar-button" onAction="#handleToDo" visible="false" managed="false"/>
        <!-- Recruiter only -->
        <Button fx:id="activitiesTab" text="📋  Activities" styleClass="sidebar-button" onAction="#handleActivities" visible="false" managed="false"/>
        <Button fx:id="projectsTab" text="📁  Projects" styleClass="sidebar-button" onAction="#handleProjects" visible="false" managed="false"/>

        <Region VBox.vgrow="ALWAYS"/>

        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="ACCOUNT" styleClass="sidebar-section-label"/>
        <Button text="👤  My Profile" styleClass="sidebar-button-active" onAction="#handlePlaceholder"/>
        <Button text="⚙  Settings" styleClass="sidebar-button" onAction="#handleSettings"/>
        <Button text="🚪  Logout" styleClass="sidebar-button-danger" onAction="#handleLogout"/>
    </VBox>

    <!-- ======= MAIN CONTENT (SCROLLABLE) ======= -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="24" style="-fx-padding: 30;" alignment="TOP_CENTER">

            <!-- Top Bar -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox>
                    <Label text="My Profile" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                    <Label text="View and manage your professional profile" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Completion Bar (built programmatically) -->
            <VBox fx:id="completionBarContainer" alignment="TOP_CENTER" style="-fx-padding: 0 0 4 0;"/>

            <!-- Profile Card -->
            <VBox fx:id="profileCard" maxWidth="800"
                  style="-fx-background-color: white; -fx-background-radius: 16;
                         -fx-border-color: #e5e7eb; -fx-border-radius: 16;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 3);">

                <!-- Header with gradient banner + avatar -->
                <VBox alignment="CENTER" spacing="8"
                      style="-fx-background-color: linear-gradient(to right, #0D203B, #1e40af);
                             -fx-background-radius: 16 16 0 0; -fx-padding: 32;">
                    <StackPane alignment="CENTER" style="-fx-pref-width: 90; -fx-pref-height: 90;">
                        <ImageView fx:id="avatarImageView" fitHeight="90" fitWidth="90"
                                   preserveRatio="true" smooth="true" visible="false"/>
                        <Label fx:id="avatarLabel" styleClass="avatar-large"/>
                    </StackPane>
                    <Text fx:id="nameText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: white;" text="Loading..."/>
                    <Text fx:id="titleText" style="-fx-font-size: 14px; -fx-fill: rgba(255,255,255,0.75);" text="..."/>
                </VBox>

                <!-- Contact Info Row -->
                <HBox spacing="20" alignment="CENTER" style="-fx-padding: 16; -fx-background-color: #f9fafb;">
                    <Label fx:id="locationLabel" text="📍 Location" style="-fx-text-fill: #374151; -fx-font-size: 12px;"/>
                    <Label text="•" style="-fx-text-fill: #d1d5db;"/>
                    <Label fx:id="phoneLabel" text="📞 Phone" style="-fx-text-fill: #374151; -fx-font-size: 12px;"/>
                    <Label text="•" style="-fx-text-fill: #d1d5db;"/>
                    <Label fx:id="emailLabel" text="✉️ Email" style="-fx-text-fill: #374151; -fx-font-size: 12px;"/>
                    <Label fx:id="verifiedBadge" text="✅ Verified"
                           style="-fx-background-color: #dcfce7; -fx-text-fill: #16a34a;
                                  -fx-padding: 3 10; -fx-background-radius: 10;
                                  -fx-font-size: 10px; -fx-font-weight: 700;" visible="false" managed="false"/>
                </HBox>

                <Separator style="-fx-opacity: 0.08;"/>

                <!-- About Section -->
                <VBox spacing="20" style="-fx-padding: 24;">
                    <VBox spacing="6">
                        <Label text="About" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <Text fx:id="summaryText" style="-fx-font-size: 13px; -fx-fill: #4b5563; -fx-wrapping-width: 700;" text="..."/>
                    </VBox>

                    <!-- Stats Row -->
                    <HBox spacing="48">
                        <VBox spacing="4">
                            <Label text="EXPERIENCE" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: #9ca3af; -fx-letter-spacing: 1;"/>
                            <Label fx:id="experienceLabel" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #111827;" text="0 Years"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="MEMBER SINCE" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: #9ca3af; -fx-letter-spacing: 1;"/>
                            <Label fx:id="joinDateLabel" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #111827;" text="—"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="BIRTH DATE" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: #9ca3af; -fx-letter-spacing: 1;"/>
                            <Label fx:id="birthDateLabel" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #111827;" text="—"/>
                        </VBox>
                    </HBox>

                    <Separator style="-fx-opacity: 0.08;"/>

                    <!-- Skills Section -->
                    <VBox spacing="10">
                        <Label text="Skills" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <FlowPane fx:id="skillsFlowPane" hgap="8" vgap="8"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="skillInput" promptText="Add a skill (e.g. Java, SQL, Design...)"
                                       style="-fx-background-radius: 10; -fx-padding: 6 12; -fx-font-size: 12px; -fx-pref-width: 250;"/>
                            <Button text="+ Add" onAction="#handleAddSkill"
                                    style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-size: 11px;
                                           -fx-font-weight: 700; -fx-padding: 6 16; -fx-background-radius: 10; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Actions -->
                <HBox spacing="12" alignment="CENTER_RIGHT"
                      style="-fx-padding: 16 24; -fx-background-color: #fafbfc; -fx-background-radius: 0 0 16 16;">
                    <Button text="✏️ Edit Profile" onAction="#handleEdit"
                            style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6);
                                   -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: 700;
                                   -fx-padding: 8 20; -fx-background-radius: 10; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.3), 6, 0, 0, 2);"/>
                    <Button text="🔄 Reset Profile" onAction="#handleReset"
                            style="-fx-background-color: #f59e0b; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: 700;
                                   -fx-padding: 8 20; -fx-background-radius: 10; -fx-cursor: hand;"/>
                    <Button text="🗑 Delete Account" onAction="#handleDelete"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: 700;
                                   -fx-padding: 8 20; -fx-background-radius: 10; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>
</HBox>
