<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentospidev.controllers.Activities.ActivityDetailsController"
      stylesheets="@/style/app.css" style="-fx-background-color: #f0f2f5;">

    <!-- ======= SIDEBAR (Candidate) ======= -->
    <VBox fx:id="sidebar" styleClass="sidebar">
       <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 1 1 1 1;">
            <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                <image><Image url="@/images/logo.png"/></image>
            </ImageView>
            <Label text="Talentos" styleClass="sidebar-logo"/>
        </HBox>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="MAIN" styleClass="sidebar-section-label"/>
        <Button text="📊  Dashboard" styleClass="sidebar-button" onAction="#handleDashboard"/>
        <Button text="💼  Job Offers" styleClass="sidebar-button" onAction="#handleJobOffers"/>
        <Button text="📈  Trends" styleClass="sidebar-button" onAction="#handleTrends"/>
        <Button text="ðŸŽ¤  Interviews" styleClass="sidebar-button" onAction="#handleInterviews"/>
        <Button text="📚  Courses" styleClass="sidebar-button" onAction="#handleCourses" maxWidth="Infinity"/>
        <Button text="ðŸ“…  Events" styleClass="sidebar-button" onAction="#handleEvents"/>
        <Button text="⚡  My Circle" styleClass="sidebar-button" onAction="#handleMyCircle"/>
        <Button text="🔔  Notifications" styleClass="sidebar-button" onAction="#handleNotifications"/>
        <Button fx:id="toDoTab" text="✅  To Do" styleClass="sidebar-button-active" onAction="#handleToDo"/>
        <Button fx:id="activitiesTab" text="📋  Activities" styleClass="sidebar-button" onAction="#handleActivities" visible="false" managed="false"/>
        <Button fx:id="projectsTab" text="📂  Projects" styleClass="sidebar-button" onAction="#handleProjects" visible="false" managed="false"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="ACCOUNT" styleClass="sidebar-section-label"/>
        <Button text="👤  My Profile" styleClass="sidebar-button" onAction="#handleMyProfile"/>
        <Button text="⚙  Settings" styleClass="sidebar-button" onAction="#handleSettings"/>
        <Button text="🚪  Logout" styleClass="sidebar-button-danger" onAction="#handleLogout"/>
    </VBox>

    <!-- ======= MAIN CONTENT ======= -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="mainContent" spacing="20" style="-fx-padding: 28;" alignment="TOP_CENTER">

            <!-- Back + Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Back to Tasks" onAction="#handleToDo"
                        style="-fx-background-color: transparent; -fx-text-fill: #6366f1;
                               -fx-font-size: 12px; -fx-font-weight: 600; -fx-cursor: hand;"/>
            </HBox>

            <!-- Activity Detail Card -->
            <VBox maxWidth="700" spacing="0"
                  style="-fx-background-color: white; -fx-background-radius: 16;
                         -fx-border-color: #e5e7eb; -fx-border-radius: 16;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">

                <!-- Header -->
                <VBox spacing="6"
                      style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6);
                             -fx-background-radius: 16 16 0 0; -fx-padding: 24;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="activityTitleLabel" text="Activity" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statusLabel" text="—"/>
                    </HBox>
                    <Label fx:id="projectNameLabel" text="—" style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                </VBox>

                <!-- Details -->
                <VBox spacing="16" style="-fx-padding: 24;">
                    <HBox spacing="24">
                        <Label fx:id="dateLabel" text="" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                        <Label fx:id="hoursLabel" text="" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                    </HBox>

                    <VBox spacing="4">
                        <Label text="Task Description" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                        <Label fx:id="descriptionLabel" text="—" wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: #4b5563; -fx-line-spacing: 2;"/>
                    </VBox>

                    <Separator/>

                    <!-- Files Section -->
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📎 Attached Files" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="+ Upload File" onAction="#uploadFile"
                                    style="-fx-background-color: #eef2ff; -fx-text-fill: #6366f1;
                                           -fx-font-size: 11px; -fx-font-weight: 700; -fx-padding: 5 12;
                                           -fx-background-radius: 8; -fx-cursor: hand;"/>
                        </HBox>
                        <VBox fx:id="filesContainer" spacing="6"/>
                    </VBox>

                    <Separator/>

                    <!-- Update Recruiter Notes -->
                    <VBox spacing="8">
                        <Label text="✍️ Send Update to Recruiter" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                        <TextArea fx:id="notesField" promptText="Write your progress update here..."
                                  prefRowCount="3" wrapText="true"
                                  style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8;"/>
                        <HBox alignment="CENTER_RIGHT">
                            <Button text="Send Update" onAction="#saveNotes"
                                    style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6);
                                           -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: 700;
                                           -fx-padding: 8 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>
