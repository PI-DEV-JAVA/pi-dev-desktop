<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentospidev.controllers.Activities.EmployeeActivityController"
      stylesheets="@/style/app.css" style="-fx-background-color: #f0f2f5;">

    <!-- ======= SIDEBAR (Candidate) ======= -->
    <VBox fx:id="sidebar" styleClass="sidebar">
       <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 1 1 1 1;">
            <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                <image><Image url="@/images/logo.png"/></image>
            </ImageView>
            <Label text="Talentos" styleClass="sidebar-logo"/>
        </HBox>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="MAIN" styleClass="sidebar-section-label"/>
        <Button text="📊  Dashboard" styleClass="sidebar-button" onAction="#handleDashboard"/>
        <Button text="💼  Job Offers" styleClass="sidebar-button" onAction="#handleJobOffers"/>
        <Button text="⚡  My Circle" styleClass="sidebar-button" onAction="#handleMyCircle"/>
        <Button text="🔔  Notifications" styleClass="sidebar-button" onAction="#handleNotifications"/>
        <Button text="✅  To Do" styleClass="sidebar-button-active" onAction="#handleToDo"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="ACCOUNT" styleClass="sidebar-section-label"/>
        <Button text="👤  My Profile" styleClass="sidebar-button" onAction="#handleMyProfile"/>
        <Button text="⚙  Settings" styleClass="sidebar-button" onAction="#handleSettings"/>
        <Button text="🚪  Logout" styleClass="sidebar-button-danger" onAction="#handleLogout"/>
    </VBox>

    <!-- ======= MAIN CONTENT ======= -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="20" style="-fx-padding: 28;">

            <!-- Welcome + Stats -->
            <VBox spacing="16"
                  style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6);
                         -fx-background-radius: 16; -fx-padding: 24;">
                <Label fx:id="welcomeLabel" text="Welcome back!" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                <HBox spacing="16">
                    <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-padding: 12 20;">
                        <Label fx:id="totalActivitiesLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                        <Label text="Activities" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.7); -fx-font-weight: 600;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-padding: 12 20;">
                        <Label fx:id="totalHoursLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                        <Label text="Total Hours" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.7); -fx-font-weight: 600;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-padding: 12 20;">
                        <Label fx:id="projectsCountLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                        <Label text="Projects" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.7); -fx-font-weight: 600;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-padding: 12 20;">
                        <Label fx:id="avgHoursLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                        <Label text="Avg Hours" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.7); -fx-font-weight: 600;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Filters -->
            <HBox spacing="12" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 10 16;
                         -fx-border-color: #e5e7eb; -fx-border-radius: 12;">
                <TextField fx:id="searchField" promptText="🔍 Search tasks..."
                           style="-fx-background-color: #f3f4f6; -fx-border-color: transparent;
                                  -fx-background-radius: 8; -fx-padding: 8 12; -fx-pref-width: 200; -fx-font-size: 12px;"/>
                <ComboBox fx:id="filterProjectCombo" prefWidth="160" style="-fx-font-size: 11px;"/>
                <DatePicker fx:id="filterDatePicker" promptText="Filter by date" style="-fx-font-size: 11px;"/>
                <Button fx:id="clearFilterBtn" text="✕ Clear"
                        style="-fx-background-color: #f3f4f6; -fx-text-fill: #6b7280; -fx-font-size: 11px;
                               -fx-padding: 6 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="activitiesCountLabel" text="" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
            </HBox>

            <!-- Activity Cards -->
            <VBox fx:id="activitiesContainer" spacing="12"/>
        </VBox>
    </ScrollPane>
</HBox>