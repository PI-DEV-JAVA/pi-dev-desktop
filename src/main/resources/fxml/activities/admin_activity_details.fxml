<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentospidev.controllers.Activities.AdminActivityDetailsController"
      stylesheets="@/style/app.css" style="-fx-background-color: #f0f2f5;">

    <!-- ======= SIDEBAR (Recruiter) ======= -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar">
           <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 1 1 1 1;">
                <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                    <image><Image url="@/images/logo.png"/></image>
                </ImageView>
                <Label text="Talentos" styleClass="sidebar-logo"/>
            </HBox>
            <Separator style="-fx-opacity: 0.1;"/>
            <Label text="MAIN" styleClass="sidebar-section-label"/>
            <Button text="📊  Dashboard" styleClass="sidebar-button" onAction="#handleDashboard"/>
            <Button text="💼  Job Offers" styleClass="sidebar-button" onAction="#handleJobOffers"/>
            <Button text="📈  Trends" styleClass="sidebar-button" onAction="#handleTrends"/>
            <Button text="ðŸŽ¤  Interviews" styleClass="sidebar-button" onAction="#handleInterviews"/>
            <Button text="📚  Courses" styleClass="sidebar-button" onAction="#handleCourses" maxWidth="Infinity"/>
        <Button text="ðŸ“…  Events" styleClass="sidebar-button" onAction="#handleEvents"/>
            <Button text="⚡  My Circle" styleClass="sidebar-button" onAction="#handleMyCircle"/>
            <Button text="🔔  Notifications" styleClass="sidebar-button" onAction="#handleNotifications"/>
            <Button fx:id="toDoTab" text="✅  To Do" styleClass="sidebar-button" onAction="#handleToDo" visible="false" managed="false"/>
            <Button fx:id="activitiesTab" text="📋  Activities" styleClass="sidebar-button-active" onAction="#handleActivities"/>
            <Button fx:id="projectsTab" text="📂  Projects" styleClass="sidebar-button" onAction="#handleProjects"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-opacity: 0.1;"/>
            <Label text="ACCOUNT" styleClass="sidebar-section-label"/>
            <Button text="👤  My Profile" styleClass="sidebar-button" onAction="#handleMyProfile"/>
            <Button text="⚙  Settings" styleClass="sidebar-button" onAction="#handleSettings"/>
            <Button text="🚪  Logout" styleClass="sidebar-button-danger" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ======= CENTER CONTENT ======= -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5; -fx-border-color: transparent;">
            <VBox fx:id="mainContent" spacing="20" style="-fx-padding: 28; -fx-background-color: #f0f2f5;">
                
                <!-- Header with Back Button -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button text="← Back" onAction="#handleBack" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
                    <Label text="Activity Details" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                </HBox>

                <!-- Employee Info Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                    <Label text="Employee Information" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <VBox spacing="5">
                            <Label text="Name:" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="employeeNameLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Email:" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="employeeEmailLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Activity Details Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="activityIdLabel" text="Activity #0" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #6366f1;"/>
                        <Label fx:id="statusLabel" text="PLANNED" style="-fx-background-color: #f3f4f6; -fx-text-fill: #6b7280; -fx-padding: 4 12; -fx-background-radius: 10; -fx-font-size: 11px; -fx-font-weight: 700;"/>
                    </HBox>
                    
                    <GridPane hgap="20" vgap="10">
                        <Label text="Project:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                        <Label fx:id="projectNameLabel" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                        
                        <Label text="Date:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                        <Label fx:id="dateLabel" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                        
                        <Label text="Assigned Hours:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                        <Label fx:id="hoursLabel" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                    </GridPane>
                    
                    <Label text="Description:" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="descriptionLabel" text="-" wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #374151; -fx-background-color: #f9fafb; -fx-padding: 12; -fx-background-radius: 8;"/>
                </VBox>

                <!-- Time Tracking Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="⏱ Time Tracking" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                        <Label fx:id="currentStatusLabel" text="○ NOT STARTED" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox fx:id="liveTrackingPanel" spacing="10" alignment="CENTER_RIGHT">
                            <ToggleButton fx:id="trackLiveToggle" text="Live Tracking Off" style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 6 12; -fx-font-size: 11px;"/>
                        </HBox>
                    </HBox>
                    
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Tracked Time" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="trackedTimeLabel" text="0h 0m" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #6366f1;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Completion" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="completionLabel" text="0%" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #f59e0b;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Sessions" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="sessionsLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #10b981;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Last Active" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="lastActiveLabel" text="Never" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #6b7280;"/>
                        </VBox>
                    </HBox>
                    
                    <ProgressBar fx:id="progressBar" progress="0.0" prefWidth="Infinity" prefHeight="8" style="-fx-accent: #6366f1;"/>
                    
                    <Label text="Tracking History" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151; -fx-padding: 10 0 0 0;"/>
                    <ListView fx:id="trackingHistoryList" prefHeight="150" style="-fx-background-color: #f9fafb; -fx-background-radius: 8;"/>
                    
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="🔄 Refresh" onAction="#refreshData" style="-fx-background-color: #eef2ff; -fx-text-fill: #6366f1; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
                        <Button text="📧 Send Reminder" onAction="#sendReminder" style="-fx-background-color: #fef3c7; -fx-text-fill: #d97706; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- Files Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📎 Uploaded Files" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="📦 Download All" onAction="#downloadAllFiles" style="-fx-background-color: #eef2ff; -fx-text-fill: #6366f1; -fx-background-radius: 8; -fx-padding: 6 12; -fx-cursor: hand; -fx-font-size: 11px;"/>
                    </HBox>
                    
                    <VBox fx:id="filesContainer" spacing="8"/>
                    
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="✅ Mark as Reviewed" onAction="#markAsReviewed" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
