<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentos.pidev.controllers.SidebarController"
      prefWidth="260"
      styleClass="sidebar"
      spacing="0">


    <HBox spacing="12" styleClass="sidebar-header" alignment="CENTER_LEFT">
        <padding>
            <Insets top="24" right="20" bottom="24" left="20"/>
        </padding>
        <StackPane>
            <!-- Cercle de fond (si l'image ne charge pas) -->
            <Circle radius="22" style="-fx-fill: linear-gradient(to bottom right, #6366F1, #06B6D4);" visible="false"/>
            <!-- Logo image -->
            <ImageView fitWidth="40" fitHeight="40" preserveRatio="true">
                <Image url="/images/logo.png"/>
                <clip>
                    <Circle radius="20" centerX="20" centerY="20"/>
                </clip>
            </ImageView>
        </StackPane>
        <VBox spacing="1">
            <Label text="TalentOS" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Gestion RH" style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
        </VBox>
    </HBox>

    <!-- Navigation Menu -->
    <VBox spacing="4" styleClass="sidebar-menu" VBox.vgrow="ALWAYS">
        <padding>
            <Insets left="12" right="12" top="16" bottom="10"/>
        </padding>

        <Label text="MENU PRINCIPAL" style="-fx-font-size: 10px; -fx-text-fill: #475569; -fx-font-weight: 700; -fx-padding: 8 8 8 12;"/>

        <Button text="📊  Tableau de Bord" onAction="#handleDashboard" styleClass="sidebar-button" maxWidth="Infinity"/>
        <Button text="📋  Offres d'emploi" onAction="#handleOffers" styleClass="sidebar-button" maxWidth="Infinity"/>
        <Button text="👥  Candidatures" onAction="#handleApplications" styleClass="sidebar-button" maxWidth="Infinity"/>
        <Button text="🎤  Interviews" onAction="#handleInterviews" styleClass="sidebar-button" maxWidth="Infinity"/>
        <Button text="📅  Activités" onAction="#handleActivities" styleClass="sidebar-button" maxWidth="Infinity"/>
        <Button text="📁  Projets" onAction="#handleProjects" styleClass="sidebar-button" maxWidth="Infinity"/>
        <Button text="👤  Espace candidat" onAction="#handleCandidateView" styleClass="sidebar-button" maxWidth="Infinity"/>

        <Button text="📈  Tendances marché" onAction="#handleMarketTrends"
                styleClass="sidebar-button" maxWidth="Infinity"/>
        <Separator>
            <padding>
                <Insets top="10" bottom="10"/>
            </padding>
        </Separator>

        <Label text="SYSTÈME" style="-fx-font-size: 10px; -fx-text-fill: #475569; -fx-font-weight: 700; -fx-padding: 4 8 8 12;"/>

        <Button text="📊  Rapports" onAction="#handleReports" styleClass="sidebar-button" maxWidth="Infinity"/>
        <Button text="⚙️  Paramètres" onAction="#handleSettings" styleClass="sidebar-button" maxWidth="Infinity"/>
    </VBox>

    <!-- Spacer -->
    <Region VBox.vgrow="ALWAYS"/>

    <!-- ✅ USER PROFILE - IMAGE BIEN AJUSTÉE -->
    <HBox spacing="12" styleClass="sidebar-user" alignment="CENTER_LEFT">
        <padding>
            <Insets left="20" right="20" top="16" bottom="16"/>
        </padding>

        <!-- Avatar avec image -->
        <StackPane prefWidth="48" prefHeight="48">
            <!-- Cercle de fond (optionnel, peut être supprimé si l'image couvre tout) -->
            <Circle radius="24" style="-fx-fill: linear-gradient(to bottom right, #6366F1, #06B6D4);" visible="false"/>

            <!-- Image avec clip circulaire -->
            <ImageView fitWidth="48" fitHeight="48" preserveRatio="false">
                <Image url="/images/meniar.jpg"/>
                <clip>
                    <!-- Clip circulaire aux dimensions exactes de l'image -->
                    <Circle radius="24" centerX="24" centerY="24"/>
                </clip>
            </ImageView>
        </StackPane>

        <!-- Informations utilisateur -->
        <VBox spacing="2">
            <Label text="Meniar Mili" style="-fx-font-weight: bold; -fx-text-fill: #E2E8F0; -fx-font-size: 14px;"/>
            <Label text="RH Manager" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
        </VBox>
    </HBox>
</VBox>