<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentospidev.controllers.AddOfferController"
      stylesheets="@/style/app.css" style="-fx-background-color: #f0f2f5;">

    <!-- ======= LEFT SIDEBAR ======= -->
    <VBox fx:id="sidebar" styleClass="sidebar">
       <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 1 1 1 1;">
            <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                <image><Image url="@/images/logo.png"/></image>
            </ImageView>
            <Label text="Talentos" styleClass="sidebar-logo"/>
        </HBox>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="MAIN" styleClass="sidebar-section-label"/>
        <Button text="📊  Dashboard" styleClass="sidebar-button" onAction="#handleDashboard"/>
        <Button text="💼  Job Offers" styleClass="sidebar-button" onAction="#handleJobOffers"/>
        <Button text="⚡  My Circle" styleClass="sidebar-button" onAction="#handleMyCircle"/>
        <Button text="🔔  Notifications" styleClass="sidebar-button" onAction="#handleNotifications"/>
        <Button text="📋  Activities" styleClass="sidebar-button" onAction="#handleActivities"/>
        <Button text="📂  Projects" styleClass="sidebar-button" onAction="#handleProjects"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="ACCOUNT" styleClass="sidebar-section-label"/>
        <Button text="👤  My Profile" styleClass="sidebar-button" onAction="#handleMyProfile"/>
        <Button text="⚙  Settings" styleClass="sidebar-button" onAction="#handleSettings"/>
        <Button text="🚪  Logout" styleClass="sidebar-button-danger" onAction="#handleLogout"/>
    </VBox>

    <!-- ======= MAIN CONTENT ======= -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="24" style="-fx-padding: 30;" alignment="TOP_CENTER">

            <!-- Form Card -->
            <VBox maxWidth="700" spacing="0"
                  style="-fx-background-color: white; -fx-background-radius: 16;
                         -fx-border-color: #e5e7eb; -fx-border-radius: 16;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">

                <!-- Header -->
                <VBox spacing="6"
                      style="-fx-background-color: linear-gradient(to right, #0D203B, #1e40af);
                             -fx-background-radius: 16 16 0 0; -fx-padding: 24;">
                    <Label fx:id="pageTitle" text="Nouvelle Offre"
                           style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                    <Label fx:id="pageSubtitle" text="Remplissez les informations de l'offre d'emploi"
                           style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                </VBox>

                <!-- Form Fields -->
                <VBox spacing="18" style="-fx-padding: 24;">

                    <VBox spacing="5">
                        <HBox spacing="2" alignment="CENTER_LEFT">
                            <Label text="TITRE DU POSTE" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                            <Label text="*" styleClass="required-star"/>
                        </HBox>
                        <TextField fx:id="titleField" promptText="Ex: Développeur Full Stack"
                                   style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb;
                                          -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                        <Label fx:id="titleError" styleClass="error-label" text="" visible="false" managed="false"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="DESCRIPTION" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                        <TextArea fx:id="descriptionField" promptText="Description du poste..."
                                  prefRowCount="4" wrapText="true"
                                  style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8;"/>
                    </VBox>

                    <HBox spacing="16">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="2" alignment="CENTER_LEFT">
                                <Label text="DÉPARTEMENT" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                                <Label text="*" styleClass="required-star"/>
                            </HBox>
                            <ComboBox fx:id="departmentBox" maxWidth="Infinity" promptText="Sélectionner"
                                      style="-fx-background-radius: 8; -fx-font-size: 12px;"/>
                            <Label fx:id="departmentError" styleClass="error-label" text="" visible="false" managed="false"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="2" alignment="CENTER_LEFT">
                                <Label text="TYPE DE CONTRAT" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                                <Label text="*" styleClass="required-star"/>
                            </HBox>
                            <ComboBox fx:id="contractBox" maxWidth="Infinity" promptText="Sélectionner"
                                      style="-fx-background-radius: 8; -fx-font-size: 12px;"/>
                            <Label fx:id="contractError" styleClass="error-label" text="" visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="16">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="EXPÉRIENCE" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                            <ComboBox fx:id="experienceBox" maxWidth="Infinity" promptText="Niveau"
                                      style="-fx-background-radius: 8; -fx-font-size: 12px;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="LOCALISATION" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                            <TextField fx:id="locationField" promptText="Ex: Paris, France"
                                       style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb;
                                              -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="16">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="2" alignment="CENTER_LEFT">
                                <Label text="SALAIRE MIN ($)" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                                <Label text="*" styleClass="required-star"/>
                            </HBox>
                            <TextField fx:id="salaryMinField" promptText="0"
                                       style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb;
                                              -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                            <Label fx:id="salaryMinError" styleClass="error-label" text="" visible="false" managed="false"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="2" alignment="CENTER_LEFT">
                                <Label text="SALAIRE MAX ($)" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                                <Label text="*" styleClass="required-star"/>
                            </HBox>
                            <TextField fx:id="salaryMaxField" promptText="0"
                                       style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb;
                                              -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                            <Label fx:id="salaryMaxError" styleClass="error-label" text="" visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="16">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="2" alignment="CENTER_LEFT">
                                <Label text="POSTES DISPONIBLES" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                                <Label text="*" styleClass="required-star"/>
                            </HBox>
                            <TextField fx:id="positionsField" promptText="1"
                                       style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb;
                                              -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                            <Label fx:id="positionsError" styleClass="error-label" text="" visible="false" managed="false"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="DATE DE CLÔTURE" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                            <DatePicker fx:id="closingDatePicker" maxWidth="Infinity" style="-fx-font-size: 11px;"/>
                        </VBox>
                    </HBox>

                    <!-- Status section (hidden by default, shown in edit mode) -->
                    <VBox fx:id="statusSection" spacing="5" visible="false" managed="false">
                        <Label text="STATUT" style="-fx-text-fill: #6b7280; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                        <ComboBox fx:id="statusBox" maxWidth="Infinity" promptText="Sélectionner"
                                  style="-fx-background-radius: 8; -fx-font-size: 12px;"/>
                    </VBox>

                    <!-- Submit -->
                    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 8 0 0 0;">
                        <Button text="Annuler" onAction="#handleDashboard"
                                style="-fx-background-color: transparent; -fx-text-fill: #9ca3af; -fx-font-weight: 600;"/>
                        <Button fx:id="submitBtn" text="Publier l'offre" onAction="#handleSubmit"
                                style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6);
                                       -fx-text-fill: white; -fx-font-weight: 700; -fx-padding: 12 28;
                                       -fx-background-radius: 10; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>
