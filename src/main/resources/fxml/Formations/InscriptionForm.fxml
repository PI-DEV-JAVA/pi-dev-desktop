<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="talentos.pidev.controllers.formations.InscriptionFormController"
            styleClass="content-pane"
            prefWidth="720">

    <!-- Header -->
    <top>
        <VBox spacing="16" styleClass="filter-panel">
            <padding>
                <Insets top="22" right="22" bottom="18" left="22"/>
            </padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="📝" style="-fx-font-size: 22px;"/>
                <Label fx:id="titleLabel" text="Inscription" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Retour" onAction="#onCancel" styleClass="btn-secondary"/>
            </HBox>

            <!-- Error -->
            <Label fx:id="errorLabel" text="" styleClass="form-error" wrapText="true"/>
        </VBox>
    </top>

    <!-- Body -->
    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="18" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="12" styleClass="offer-card">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <Label text="Informations candidat" styleClass="filter-label"/>

                <TextField fx:id="nomField" promptText="Nom complet"/>
                <TextField fx:id="emailField" promptText="Email"/>
            </VBox>

            <!-- Actions -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Annuler" onAction="#onCancel" styleClass="btn-secondary"/>
                <Button text="Valider" onAction="#onSubmit" styleClass="btn-success"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>