<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentospidev.controllers.courses.QuizPassageController"
      stylesheets="@/style/app.css" style="-fx-background-color: #f0f2f5;">

    <VBox fx:id="sidebar" styleClass="sidebar">
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 1 1 1 1;">
            <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                <image><Image url="@/images/logo.png"/></image>
            </ImageView>
            <Label text="Talentos" styleClass="sidebar-logo"/>
        </HBox>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="MAIN" styleClass="sidebar-section-label"/>
        <Button text="📊  Dashboard" styleClass="sidebar-button" onAction="#handleDashboard"/>
        <Button text="💼  Job Offers" styleClass="sidebar-button" onAction="#handleJobOffers"/>
        <Button text="📈  Trends" styleClass="sidebar-button" onAction="#handleTrends"/>
        <Button text="🎤  Interviews" styleClass="sidebar-button" onAction="#handleInterviews"/>
        <Button text="📚  Courses" styleClass="sidebar-button-active" onAction="#handleCourses"/>
        <Button text="⚡  My Circle" styleClass="sidebar-button" onAction="#handleMyCircle"/>
        <Button text="🔔  Notifications" styleClass="sidebar-button" onAction="#handleNotifications"/>
        <Button fx:id="toDoTab" text="✅  To Do" styleClass="sidebar-button" onAction="#handleToDo" visible="false" managed="false"/>
        <Button fx:id="activitiesTab" text="🎯  Activities" styleClass="sidebar-button" onAction="#handleActivities" visible="false" managed="false"/>
        <Button fx:id="projectsTab" text="📁  Projects" styleClass="sidebar-button" onAction="#handleProjects" visible="false" managed="false"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="ACCOUNT" styleClass="sidebar-section-label"/>
        <Button text="👤  My Profile" styleClass="sidebar-button" onAction="#handleMyProfile"/>
        <Button text="⚙  Settings" styleClass="sidebar-button" onAction="#handleSettings"/>
        <Button text="🚪  Logout" styleClass="sidebar-button-danger" onAction="#handleLogout"/>
    </VBox>

    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;
                       -fx-border-color: transparent;">
        <VBox spacing="16" style="-fx-padding: 28;" maxWidth="800">
            <!-- Header -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="← Back" onAction="#onBack"
                        style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 8 16;
                               -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-cursor: hand; -fx-font-weight: 600;"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="quizTitleLbl" text="" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                </VBox>
                <Label fx:id="timerLbl" text="" style="-fx-font-size: 15px; -fx-text-fill: #6366f1; -fx-font-weight: 700;
                       -fx-background-color: #eef2ff; -fx-background-radius: 10; -fx-padding: 8 16;"/>
            </HBox>

            <!-- Progress bar -->
            <VBox fx:id="progressBarContainer" spacing="4"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 12 16;
                         -fx-border-color: #e5e7eb; -fx-border-radius: 12;">
                <Label fx:id="progressInfoLbl" text="Answer all questions below" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                <ProgressBar fx:id="quizProgressBar" progress="0" maxWidth="Infinity"
                             style="-fx-accent: #6366f1;" prefHeight="8"/>
            </VBox>

            <!-- Questions -->
            <VBox fx:id="questionsContainer" spacing="14"/>

            <!-- Submit -->
            <HBox alignment="CENTER" style="-fx-padding: 10 0 20 0;">
                <Button fx:id="submitBtn" text="✅ Submit Answers" onAction="#onSubmit"
                        style="-fx-background-color: linear-gradient(to right, #22c55e, #16a34a); -fx-text-fill: white;
                               -fx-background-radius: 12; -fx-padding: 14 40; -fx-font-size: 15px;
                               -fx-font-weight: 700; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(34,197,94,0.3), 12, 0, 0, 4);"/>
            </HBox>
        </VBox>
    </ScrollPane>
</HBox>
