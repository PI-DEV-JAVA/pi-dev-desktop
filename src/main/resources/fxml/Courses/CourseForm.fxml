<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="talentospidev.controllers.courses.CourseFormController"
      stylesheets="@/style/app.css" style="-fx-background-color: #f0f2f5;">

    <VBox fx:id="sidebar" styleClass="sidebar">
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 1 1 1 1;">
            <ImageView fitHeight="60" fitWidth="60" preserveRatio="true"><image><Image url="@/images/logo.png"/></image></ImageView>
            <Label text="Talentos" styleClass="sidebar-logo"/>
        </HBox>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="MAIN" styleClass="sidebar-section-label"/>
        <Button text="📊  Dashboard" styleClass="sidebar-button" onAction="#handleDashboard"/>
        <Button text="💼  Job Offers" styleClass="sidebar-button" onAction="#handleJobOffers"/>
        <Button text="📈  Trends" styleClass="sidebar-button" onAction="#handleTrends"/>
        <Button text="🎤  Interviews" styleClass="sidebar-button" onAction="#handleInterviews"/>
        <Button text="📚  Courses" styleClass="sidebar-button-active" onAction="#handleCourses"/>
        <Button text="⚡  My Circle" styleClass="sidebar-button" onAction="#handleMyCircle"/>
        <Button text="🔔  Notifications" styleClass="sidebar-button" onAction="#handleNotifications"/>
        <Button fx:id="toDoTab" text="✅  To Do" styleClass="sidebar-button" onAction="#handleToDo" visible="false" managed="false"/>
        <Button fx:id="activitiesTab" text="🎯  Activities" styleClass="sidebar-button" onAction="#handleActivities" visible="false" managed="false"/>
        <Button fx:id="projectsTab" text="📁  Projects" styleClass="sidebar-button" onAction="#handleProjects" visible="false" managed="false"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-opacity: 0.1;"/>
        <Label text="ACCOUNT" styleClass="sidebar-section-label"/>
        <Button text="👤  My Profile" styleClass="sidebar-button" onAction="#handleMyProfile"/>
        <Button text="⚙  Settings" styleClass="sidebar-button" onAction="#handleSettings"/>
        <Button text="🚪  Logout" styleClass="sidebar-button-danger" onAction="#handleLogout"/>
    </VBox>

    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="20" style="-fx-padding: 28;" maxWidth="700">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="← Back" onAction="#onCancel"
                        style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 8 16;
                               -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-cursor: hand; -fx-font-weight: 600;"/>
                <Label fx:id="pageTitleLbl" text="🎓 New Course" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
            </HBox>

            <Label fx:id="errorLbl" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 13px; -fx-font-weight: 600;"
                   visible="false" managed="false"/>

            <!-- Form Card -->
            <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 24;
                                      -fx-border-color: #e5e7eb; -fx-border-radius: 14;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 2);">

                <Label text="Course Info" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #6366f1;"/>

                <HBox spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Course Name *" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <TextField fx:id="nomField" promptText="e.g. Introduction to Java"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Category *" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <TextField fx:id="categorieField" promptText="e.g. Development"/>
                    </VBox>
                </HBox>

                <VBox spacing="4">
                    <Label text="Description" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                    <TextArea fx:id="descField" promptText="Course description..." prefRowCount="3"/>
                </VBox>

                <HBox spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Difficulty *" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <ComboBox fx:id="difficulteBox" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Mode *" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <ComboBox fx:id="modeBox" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Instructor *" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <TextField fx:id="formateurField" promptText="Instructor name"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Location" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <TextField fx:id="lieuField" promptText="City or Address"/>
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Start Date *" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <DatePicker fx:id="dateDebutPicker" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="End Date *" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <DatePicker fx:id="dateFinPicker" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Max Capacity" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <TextField fx:id="capaciteField" promptText="e.g. 30"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Prerequisites" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <TextField fx:id="prerequisField" promptText="e.g. Basic math"/>
                    </VBox>
                </HBox>

                <VBox spacing="4">
                    <Label text="Content / Syllabus" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                    <TextArea fx:id="contenuField" promptText="Course syllabus, topics, learning objectives..." prefRowCount="3"/>
                </VBox>

                <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                    <Button text="Cancel" onAction="#onCancel"
                            style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 10 24;
                                   -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-cursor: hand; -fx-font-weight: 600;"/>
                    <Button fx:id="saveBtn" text="💾 Save Course" onAction="#onSave"
                            style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6); -fx-text-fill: white;
                                   -fx-background-radius: 10; -fx-padding: 10 28; -fx-font-weight: 700; -fx-cursor: hand; -fx-font-size: 14px;"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>
