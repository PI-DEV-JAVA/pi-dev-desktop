<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pi.controllers.PresenceController">

    <top>
        <Label text="GESTION DES PRÉSENCES" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 20;" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 20;">

            <!-- Section Génération QR Code -->
            <VBox spacing="10" style="-fx-border-color: #3498db; -fx-border-radius: 5; -fx-padding: 15;">
                <Label text="Générer QR Code" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="ID Participation:" />
                    <TextField fx:id="idParticipationField" promptText="Entrez l'ID" HBox.hgrow="ALWAYS" />
                    <Button onAction="#genererQRCode" text="Générer QR" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
                    <Button onAction="#sauvegarderQRCode" text="Sauvegarder" />
                </HBox>

                <ImageView fx:id="qrImageView" fitHeight="200" fitWidth="200" preserveRatio="true" />
            </VBox>

            <!-- Section Scanner -->
            <VBox spacing="10" style="-fx-border-color: #27ae60; -fx-border-radius: 5; -fx-padding: 15;">
                <Label text="Scanner Présence" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Code QR:" />
                    <TextField fx:id="scannerField" promptText="Scannez ou entrez le code" HBox.hgrow="ALWAYS" />
                    <Button onAction="#scannerPresence" text="Valider" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
                </HBox>

                <Label fx:id="statutLabel" text="En attente de scan" style="-fx-font-size: 16px;" />
            </VBox>

            <!-- Section Statistiques -->
            <VBox spacing="10" style="-fx-border-color: #e74c3c; -fx-border-radius: 5; -fx-padding: 15;">
                <Label text="Statistiques" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                <HBox spacing="20">
                    <VBox>
                        <Label text="ID Événement:" />
                        <TextField fx:id="eventIdField" promptText="ID événement" />
                        <Button onAction="#chargerEvenement" text="Charger" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Présents:" />
                        <Label fx:id="presentsCountLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Taux:" />
                        <Label fx:id="tauxPresenceLabel" text="0%" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>