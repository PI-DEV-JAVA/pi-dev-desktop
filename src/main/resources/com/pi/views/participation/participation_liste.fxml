<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pi.controllers.ParticipationController">

    <!-- Menu Latéral -->
    <left>
        <VBox prefWidth="200" spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 30 20 30 20;" BorderPane.alignment="CENTER">
            <children>
                <Label text="TalentOs" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 20 0;" />
                <Label text="📊 Dashboard" style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-padding: 10 15 10 15;" />
                <Label text="📅 Events" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 15 10 15; -fx-background-color: #3498db; -fx-background-radius: 5;" />
            </children>
        </VBox>
    </left>

    <!-- Contenu -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="15" alignment="TOP_CENTER" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <children>
                    <Label text="LISTE DES PARTICIPATIONS" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 20 0;" />

                    <!-- Barre de recherche -->
                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #ecf0f1; -fx-border-radius: 5;">
                        <children>
                            <TextField fx:id="rechercheField" promptText="ID Événement ou Utilisateur..." HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-radius: 5; -fx-padding: 8 12 8 12; -fx-font-size: 14px;" />
                            <Button mnemonicParsing="false" onAction="#rechercherParEvenement" text="Par événement" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15 8 15; -fx-background-radius: 5;" />
                            <Button mnemonicParsing="false" onAction="#rechercherParUtilisateur" text="Par utilisateur" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15 8 15; -fx-background-radius: 5;" />
                            <Button mnemonicParsing="false" onAction="#actualiser" text="Actualiser" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15 8 15; -fx-background-radius: 5;" />
                        </children>
                    </HBox>

                    <!-- Liste des participations -->
                    <ListView fx:id="listViewParticipations" VBox.vgrow="ALWAYS" prefHeight="400" style="-fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-radius: 5;" />

                    <!-- Détails -->
                    <TextField fx:id="detailField" editable="false" promptText="Cliquez sur une participation pour voir les détails" style="-fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-radius: 5; -fx-padding: 8 12 8 12; -fx-font-size: 14px;" />

                    <!-- Information totale -->
                    <Label fx:id="infoLabel" text="Total: 0 participation(s)" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                </children>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>