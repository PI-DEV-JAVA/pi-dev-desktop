<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainBorderPane" prefHeight="850" prefWidth="1300" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pi.controllers.MainController">

    <!-- ======= SIDEBAR UNIQUE ======= -->
    <left>
        <VBox prefWidth="260" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 1 0 0; -fx-padding: 20 0 0 0;">

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 20 20;">
                <Label text="🎯" style="-fx-font-size: 32px;"/>
                <Label text="Talentos" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
            </HBox>

            <Separator style="-fx-opacity: 0.1; -fx-padding: 0 0 10 0;"/>

            <!-- MAIN SECTION -->
            <Label text="MAIN" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280; -fx-padding: 10 20 8 20;"/>

            <Button fx:id="btnEvents" maxWidth="Infinity" onAction="#openEvenementGestion"
                    style="-fx-background-color: #eef2ff; -fx-text-fill: #6366f1; -fx-font-size: 13px; -fx-font-weight: 700; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand; -fx-border-color: transparent transparent transparent #6366f1; -fx-border-width: 0 0 0 3px;"
                    text="📅  Events"/>

            <Button fx:id="btnEvenementListe" maxWidth="Infinity" onAction="#openEvenementListe"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    text="📋  Liste Événements"/>

            <Button fx:id="btnParticipations" maxWidth="Infinity" onAction="#openParticipationGestion"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    text="👥  Participations"/>

            <Button fx:id="btnParticipationListe" maxWidth="Infinity" onAction="#openParticipationListe"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    text="📋  Liste Participations"/>

            <Button fx:id="btnPresences" maxWidth="Infinity" onAction="#openPresence"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    text="✅  Présences"/>

            <Button fx:id="btnCalendrier" maxWidth="Infinity" onAction="#openCalendrier"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    text="📅  Calendrier"/>

            <Button fx:id="btnFeedback" maxWidth="Infinity" onAction="#openFeedback"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    text="⭐  Feedback"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-opacity: 0.1;"/>

            <!-- ACCOUNT SECTION -->
            <Label text="ACCOUNT" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280; -fx-padding: 20 20 8 20;"/>

            <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    text="👤  My Profile"/>

            <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    text="⚙  Settings"/>

            <Button maxWidth="Infinity" onAction="#quit"
                    style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-font-size: 13px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-cursor: hand;"
                    text="🚪  Logout"/>
        </VBox>
    </left>

    <!-- ======= CENTER CONTENT ======= -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 30;">

                <!-- Header -->
                <VBox spacing="16" style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6); -fx-background-radius: 16; -fx-padding: 24;">
                    <Label text="Events Management" style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                    <Label text="Gérez vos événements, participations et présences" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                </VBox>

                <!-- Quick Access Cards - CORRIGÉ : wrapText supprimé -->
                <HBox spacing="20" alignment="CENTER">
                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24; -fx-min-width: 180; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                        <Label text="📋" style="-fx-font-size: 32px;"/>
                        <Label text="Événements" style="-fx-font-size: 16px; -fx-font-weight: 700;"/>
                        <Button text="Liste" onAction="#openEvenementListe" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
                    </VBox>

                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24; -fx-min-width: 180; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                        <Label text="👥" style="-fx-font-size: 32px;"/>
                        <Label text="Participations" style="-fx-font-size: 16px; -fx-font-weight: 700;"/>
                        <Button text="Liste" onAction="#openParticipationListe" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>