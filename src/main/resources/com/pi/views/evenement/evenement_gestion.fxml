<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="24" style="-fx-padding: 30; -fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pi.controllers.EvenementController">

    <!-- Header -->
    <VBox spacing="16" style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6); -fx-background-radius: 16; -fx-padding: 24;">
        <Label text="Gestion des Événements" style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: white;"/>
        <Label text="Ajouter, modifier ou supprimer des événements" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.8);"/>
    </VBox>

    <!-- Search Bar -->
    <HBox spacing="12">
        <TextField fx:id="rechercheTitreField" promptText="Rechercher par titre..." HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 10 14;"/>
        <Button text="Rechercher" onAction="#rechercherParTitre" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
    </HBox>

    <!-- Form Card -->
    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
        <Label text="Formulaire" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>

        <GridPane hgap="15" vgap="15">
            <Label text="Titre:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
            <TextField fx:id="titreField" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 8 12;"/>

            <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
            <TextField fx:id="typeField" promptText="Job Fair/Workshop/Conference" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 8 12;"/>

            <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
            <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8;"/>

            <Label text="Lieu:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
            <TextField fx:id="lieuField" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 8 12;"/>

            <Label text="Statut:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
            <TextField fx:id="statutField" promptText="Actif/Annulé" GridPane.columnIndex="1" GridPane.rowIndex="4" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 8 12;"/>
        </GridPane>

        <!-- Action Buttons -->
        <HBox spacing="12" alignment="CENTER">
            <Button text="Ajouter" onAction="#ajouterEvenement" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: bold;"/>
            <Button text="Modifier" onAction="#modifierEvenement" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: bold;"/>
            <Button text="Supprimer" onAction="#supprimerEvenement" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: bold;"/>
            <Button text="Effacer" onAction="#effacerFormulaire" style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
            <Button text="Partager" onAction="#partagerEvenement" style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</VBox>