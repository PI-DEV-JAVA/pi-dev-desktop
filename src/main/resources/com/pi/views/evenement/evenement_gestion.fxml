<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pi.controllers.EvenementController">

    <left>
        <VBox prefWidth="200" spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 30 20 30 20;" BorderPane.alignment="CENTER">
            <children>
                <Label text="TalentOs" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 20 0;" />
                <Label text="📊 Dashboard" style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-padding: 10 15 10 15;" />
                <Label text="📅 Events" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 15 10 15; -fx-background-color: #3498db; -fx-background-radius: 5;" />
            </children>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20" alignment="TOP_CENTER" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <children>
                    <Label text="GESTION DES ÉVÉNEMENTS" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 20 0;" />

                    <!-- Barre de recherche par TITRE -->
                    <HBox spacing="10" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #ecf0f1; -fx-border-radius: 5;">
                        <children>
                            <Label text="Rechercher par Titre:" style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;" />
                            <TextField fx:id="rechercheTitreField" promptText="Entrez le titre" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-radius: 5; -fx-padding: 8 12 8 12; -fx-font-size: 14px;" />
                            <Button mnemonicParsing="false" onAction="#rechercherParTitre" text="Rechercher" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15 8 15; -fx-background-radius: 5;" />
                        </children>
                    </HBox>

                    <!-- Formulaire -->
                    <GridPane hgap="15" vgap="15" alignment="CENTER">
                        <children>
                            <Label text="Titre:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;" />
                            <TextField fx:id="titreField" style="-fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-radius: 5; -fx-padding: 8 12 8 12; -fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;" />
                            <TextField fx:id="typeField" promptText="Job Fair/Workshop/Conference" style="-fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-radius: 5; -fx-padding: 8 12 8 12; -fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;" />
                            <DatePicker fx:id="datePicker" style="-fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-radius: 5; -fx-padding: 8 12 8 12; -fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <Label text="Lieu:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;" />
                            <TextField fx:id="lieuField" style="-fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-radius: 5; -fx-padding: 8 12 8 12; -fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <Label text="Statut:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;" />
                            <TextField fx:id="statutField" promptText="Actif/Annulé" style="-fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-radius: 5; -fx-padding: 8 12 8 12; -fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        </children>
                        <columnConstraints>
                            <javafx.scene.layout.ColumnConstraints minWidth="100" halignment="RIGHT" />
                            <javafx.scene.layout.ColumnConstraints minWidth="300" hgrow="ALWAYS" />
                        </columnConstraints>
                    </GridPane>

                    <!-- Boutons CRUD + Partager -->
                    <HBox spacing="20" alignment="CENTER">
                        <children>
                            <Button mnemonicParsing="false" onAction="#ajouterEvenement" text="Ajouter" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20 10 20; -fx-background-radius: 5;" />
                            <Button mnemonicParsing="false" onAction="#modifierEvenement" text="Modifier" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20 10 20; -fx-background-radius: 5;" />
                            <Button mnemonicParsing="false" onAction="#supprimerEvenement" text="Supprimer" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20 10 20; -fx-background-radius: 5;" />
                            <Button mnemonicParsing="false" onAction="#partagerEvenement" text="📱 Partager" style="-fx-background-color: #1DA1F2; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20 10 20; -fx-background-radius: 5;" />
                            <Button mnemonicParsing="false" onAction="#effacerFormulaire" text="Effacer" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20 10 20; -fx-background-radius: 5;" />
                        </children>
                    </HBox>
                </children>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>