<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="24" style="-fx-padding: 30; -fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pi.controllers.EvenementController">

    <!-- Header -->
    <VBox spacing="16" style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6); -fx-background-radius: 16; -fx-padding: 24;">
        <Label text="Liste des Événements" style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: white;"/>
        <Label text="Consultez tous les événements disponibles" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.8);"/>
    </VBox>

    <!-- Search Bar -->
    <HBox spacing="12">
        <TextField fx:id="rechercheField" promptText="Rechercher par titre, type ou lieu..." HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 10 14;"/>
        <Button text="Rechercher" onAction="#rechercher" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
        <Button text="Actualiser" onAction="#actualiser" style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
    </HBox>

    <!-- Filter Chips -->
    <HBox spacing="12">
        <Button text="Tous" onAction="#afficherTous" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 6 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
        <Button text="Actifs" onAction="#afficherActifs" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 6 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
        <Button text="À venir" onAction="#afficherAVenir" style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 6 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
        <Button text="Passés" onAction="#afficherPasses" style="-fx-background-color: #94a3b8; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 6 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
        <Button text="Annulés" onAction="#afficherAnnules" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 6 16; -fx-cursor: hand; -fx-font-size: 12px;"/>
    </HBox>

    <!-- List View -->
    <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
        <ListView fx:id="listViewEvenements" prefHeight="400" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8;"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label fx:id="totalEvenementsLabel" text="Total: 0 événements" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #6366f1;"/>
        </HBox>

        <TextField fx:id="detailField" editable="false" promptText="Cliquez sur un événement pour voir les détails" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 10;"/>
    </VBox>
</VBox>