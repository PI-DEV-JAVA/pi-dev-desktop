<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="24" style="-fx-padding: 30; -fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pi.controllers.FeedbackController">

    <!-- Header -->
    <VBox spacing="16" style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6); -fx-background-radius: 16; -fx-padding: 24;">
        <Label text="Satisfaction &amp; Feedback" style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: white;"/>
        <Label text="Recueillez les avis des participants" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.8);"/>
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: transparent;">
        <!-- Tab Vue d'ensemble -->
        <Tab text="📈 Vue d'ensemble">
            <content>
                <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 16;">
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <Label text="Sélectionner un événement:" style="-fx-font-weight: 600;"/>
                        <ComboBox fx:id="evenementCombo" prefWidth="350" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 5;"/>
                        <Button text="Charger" onAction="#chargerFeedbacks" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;"/>
                    </HBox>

                    <HBox spacing="20" alignment="CENTER">
                        <VBox spacing="5" alignment="CENTER" style="-fx-background-color: #f9fafb; -fx-padding: 20; -fx-background-radius: 12;">
                            <Label text="Note moyenne" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="noteMoyenneLabel" text="0.0" style="-fx-font-size: 36px; -fx-font-weight: 800; -fx-text-fill: #f59e0b;"/>
                        </VBox>
                        <VBox spacing="5" alignment="CENTER" style="-fx-background-color: #f9fafb; -fx-padding: 20; -fx-background-radius: 12;">
                            <Label text="Total feedbacks" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="totalFeedbacksLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: 800; -fx-text-fill: #6366f1;"/>
                        </VBox>
                    </HBox>

                    <ListView fx:id="commentairesListView" prefHeight="200" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8;"/>
                </VBox>
            </content>
        </Tab>

        <!-- Tab Ajouter feedback -->
        <Tab text="➕ Ajouter feedback">
            <content>
                <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 16;">
                    <GridPane hgap="15" vgap="15">
                        <Label text="ID Participation:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: 600;"/>
                        <TextField fx:id="idParticipationField" promptText="ex: 123" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 8;"/>

                        <Label text="Note:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: 600;"/>
                        <ComboBox fx:id="noteCombo" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb;"/>

                        <Label text="Commentaire:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: 600;"/>
                        <TextArea fx:id="commentaireField" prefRowCount="4" prefWidth="350" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8;"/>

                        <Label text="Recommande:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: 600;"/>
                        <CheckBox fx:id="recommandeCheck" text="Oui, je recommande" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </GridPane>

                    <HBox spacing="20" alignment="CENTER">
                        <Button text="Soumettre feedback" onAction="#ajouterFeedback" style="-fx-background-color: linear-gradient(to right, #6366f1, #8b5cf6); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
                        <Button text="Annuler" onAction="#effacerFormulaire" style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </content>
        </Tab>
    </TabPane>
</VBox>