<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="talentos.pidev.controllers.MediaController" 
            style="-fx-background-color: #202124;">
    
    <!-- video layoyt -->
    <center>
        <StackPane>


            <TilePane fx:id="videoGrid" 
          alignment="CENTER" 
          hgap="10" vgap="10" 
          prefColumns="2" 
          prefRows="2"
          tileAlignment="CENTER"
          VBox.vgrow="ALWAYS" 
          style="-fx-background-color: #202124; -fx-padding: 10;">
</TilePane>
            
            <StackPane StackPane.alignment="BOTTOM_CENTER" maxHeight="80">
                <HBox alignment="CENTER" spacing="15" 
                      style="-fx-background-color: rgba(60, 64, 67, 0.9); -fx-background-radius: 40; -fx-padding: 10 30 10 30;">
                    <StackPane.margin>
                        <Insets bottom="20"/>
                    </StackPane.margin>
                    
                    <Button fx:id="muteBtn" onAction="#toggleMute" text="Mic" 
                            style="-fx-background-radius: 50; -fx-min-width: 50; -fx-min-height: 50; -fx-background-color: #3c4043; -fx-text-fill: white;"/>
                    
                    <Button fx:id="camBtn" onAction="#toggleCam" text="Cam" 
                            style="-fx-background-radius: 50; -fx-min-width: 50; -fx-min-height: 50; -fx-background-color: #3c4043; -fx-text-fill: white;"/>
                    
                    <Button onAction="#stopAll" text="Hang Up" 
                            style="-fx-background-radius: 50; -fx-min-width: 80; -fx-min-height: 50; -fx-background-color: #ea4335; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </StackPane>
        </StackPane>
    </center>

    <!-- chat sidebar -->
   <right>
        <StackPane prefWidth="350">
            <padding>
                <Insets top="20" right="20" bottom="60" left="10"/> 
            </padding>
            
            <VBox spacing="10" 
                  style="-fx-background-color: white; 
                         -fx-background-radius: 15; 
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); 
                         -fx-padding: 15;">
                
                <Label text="In-call messages" 
                       style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #202124;"/>
                
                <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" 
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                    <VBox fx:id="chatBox" spacing="8" style="-fx-background-color: white;"/>
                </ScrollPane>
                
                <HBox spacing="8" alignment="CENTER">
                    <TextField fx:id="messageInput" HBox.hgrow="ALWAYS" promptText="Send a message" 
                               style="-fx-background-radius: 20; -fx-background-color: #f1f3f4; -fx-padding: 10;"/>
                    <Button onAction="#sendMessage" text="Send" 
                            style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </StackPane>
    </right>
</BorderPane>